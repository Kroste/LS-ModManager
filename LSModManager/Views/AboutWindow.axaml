<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LSModManager.Views"
        xmlns:controls="using:LSModManager.Controls"
        xmlns:loc="using:LSModManager.Localization"
        x:Class="LSModManager.Views.AboutWindow"
        Width="460" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr Window_About}"
        Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Window_About}" />
        <StackPanel Margin="24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="LS-ModManager" Classes="h1" FontSize="22" />
                <TextBlock Text="{loc:Tr About_Description}"
                           Classes="secondary" TextWrapping="Wrap" />
                <TextBlock x:Name="VersionText" Classes="muted" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>

            <Rectangle Classes="divider-h" />

            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="UpdateButton" Classes="accent" Content="{loc:Tr About_CheckUpdates}" />
                    <Button x:Name="InstallUpdateButton" Content="{loc:Tr Installed_InstallUpdate}"
                            IsVisible="False" />
                    <TextBlock x:Name="UpdateResult" VerticalAlignment="Center" Classes="secondary" />
                </StackPanel>
                <ProgressBar x:Name="UpdateProgress" IsVisible="False"
                             Minimum="0" Maximum="1" Value="0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="GithubButton" Content="GitHub" />
                <Button x:Name="BmcButton" Content="☕ Buy me a coffee" />
            </StackPanel>

            <TextBlock Text="{loc:Tr About_License}"
                       Foreground="#6B7280" FontSize="11" />
        </StackPanel>
    </DockPanel>
</views:ChromeWindow>
