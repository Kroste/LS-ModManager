<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LSModManager.Views"
        xmlns:controls="using:LSModManager.Controls"
        xmlns:vm="using:LSModManager.ViewModels"
        xmlns:loc="using:LSModManager.Localization"
        x:Class="LSModManager.Views.ModDetailWindow"
        x:DataType="vm:ModDetailViewModel"
        Width="820" Height="720"
        MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr Window_ModDetail}"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{Binding Title}" />

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Padding="20,10"
                Background="{DynamicResource KrosteTitleBarBrush}"
                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Classes="muted" />
                <ProgressBar Grid.Column="1" IsIndeterminate="True"
                             Width="120" Margin="12,0"
                             IsVisible="{Binding IsLoading}" />
                <Button Grid.Column="2" Content="{loc:Tr ModDetail_OpenInBrowser}"
                        Margin="0,0,8,0"
                        Command="{Binding OpenInBrowserCommand}" />
                <Button Grid.Column="3" Classes="accent" Content="{loc:Tr ModDetail_Download}"
                        Command="{Binding DownloadCommand}" />
            </Grid>
        </Border>

        <ScrollViewer Padding="20,16">
            <StackPanel Spacing="14">
                <!-- Header -->
                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Title}" Classes="h1" FontSize="22" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Author}" Classes="muted" />
                            <TextBlock Text="·" Classes="muted"
                                       IsVisible="{Binding Category, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding Category}" Classes="muted" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Classes="secondary" FontSize="12"
                                       IsVisible="{Binding Version, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding SizeText}" Classes="secondary" FontSize="12"
                                       IsVisible="{Binding SizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding ReleaseDate}" Classes="secondary" FontSize="12"
                                       IsVisible="{Binding ReleaseDate, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding Platform}" Classes="secondary" FontSize="12"
                                       IsVisible="{Binding Platform, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding Rating, StringFormat='⭐ {0}'}" Classes="secondary" FontSize="12"
                                       Foreground="{DynamicResource KrosteGoldBrush}"
                                       IsVisible="{Binding Rating, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- KI-Toolbar direkt unter dem Header, damit die Buttons sofort
                     sichtbar sind (die Beschreibung darunter kann bei Community-
                     Mods sehr lang sein und die Ergebnis-Cards unten außer Sicht
                     drücken). Card verschwindet komplett wenn kein KI-Provider
                     konfiguriert ist. -->
                <Border Classes="card" IsVisible="{Binding IsAiEnabled}" Padding="12,10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{loc:Tr ModDetail_AiSummarize}"
                                Command="{Binding SummarizeCommand}" />
                        <Button Content="{loc:Tr ModDetail_AiSimilarLoad}"
                                Command="{Binding FindSimilarModsCommand}" />
                    </StackPanel>
                </Border>

                <!-- Screenshots -->
                <Border Classes="card"
                        IsVisible="{Binding ScreenshotUrls.Count}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr ModDetail_Screenshots}" Classes="section-label" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ScreenshotUrls}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="360" Height="200"
                                                Background="{DynamicResource KrosteSurfaceBrush}"
                                                CornerRadius="6" ClipToBounds="True">
                                            <Image controls:UrlImageBehavior.Url="{Binding}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Beschreibung -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr ModDetail_Description}" Classes="section-label" />
                        <TextBox Text="{Binding Description, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 MinHeight="200" />
                    </StackPanel>
                </Border>

                <!-- KI-Zusammenfassung: Card taucht auf sobald SummaryText gefüllt ist -->
                <Border Classes="card" IsVisible="{Binding HasSummary}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr ModDetail_AiSummary}" Classes="section-label"
                                   Foreground="{DynamicResource KrosteGoldBrush}" />
                        <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap"
                                   Classes="secondary" FontSize="13" />
                    </StackPanel>
                </Border>

                <!-- Ähnliche Mods: Card taucht auf sobald Ergebnisse (oder ein
                     „nichts gefunden"-Signal) da sind. Der Auslöse-Button sitzt
                     oben in der KI-Toolbar-Card unter dem Header. -->
                <Border Classes="card" IsVisible="{Binding HasSimilarResults}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr ModDetail_AiSimilar}" Classes="section-label"
                                   Foreground="{DynamicResource KrosteGoldBrush}" />
                        <TextBlock Text="{loc:Tr ModDetail_AiSimilarNone}"
                                   Classes="muted" FontSize="12"
                                   IsVisible="{Binding SimilarNoResults}" />
                        <ItemsControl ItemsSource="{Binding SimilarMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ModHubItemViewModel">
                                    <!-- Vollwertige Katalog-Card statt kompakter Zeile:
                                         Cover + Titel/Autor/Kategorie/Source-Badge + drei
                                         Action-Buttons (📥 Download bei GIANTS,
                                         🌐 Öffnen bei Modhoster/Hof-Hirschfeld, 👁 Details
                                         bei GIANTS öffnet neues Detail-Fenster). -->
                                    <Border Classes="card" Margin="0,0,0,8" Padding="12">
                                        <Grid ColumnDefinitions="120,*,Auto">
                                            <Border Width="120" Height="76"
                                                    Background="{DynamicResource KrosteSurfaceBrush}"
                                                    CornerRadius="6" ClipToBounds="True">
                                                <Panel>
                                                    <TextBlock Text="🌐" FontSize="30"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource KrosteMutedTextBrush}" />
                                                    <Image controls:UrlImageBehavior.Url="{Binding PreviewUrl}"
                                                           Stretch="UniformToFill" />
                                                </Panel>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,2,0,2" Spacing="4"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Background="{DynamicResource KrosteAccentSoftBrush}"
                                                            CornerRadius="10" Padding="8,1"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding NeedsBrowser}">
                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="10"
                                                                   Foreground="{DynamicResource KrosteSecondaryTextBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Author}" Classes="muted" FontSize="11" />
                                                    <TextBlock Text="·" Classes="muted" FontSize="11"
                                                               IsVisible="{Binding Category, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    <TextBlock Text="{Binding Category}" Classes="muted" FontSize="11" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                                <Button Classes="accent" Content="{loc:Tr Catalog_Download}"
                                                        IsVisible="{Binding CanInAppDownload}"
                                                        Command="{Binding $parent[Window].((vm:ModDetailViewModel)DataContext).DownloadSimilarCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Classes="accent" Content="{loc:Tr Catalog_OpenInBrowser}"
                                                        IsVisible="{Binding NeedsBrowser}"
                                                        Command="{Binding $parent[Window].((vm:ModDetailViewModel)DataContext).OpenSimilarInBrowserCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="{loc:Tr Catalog_Details}"
                                                        HorizontalAlignment="Right"
                                                        IsVisible="{Binding IsGiantsSource}"
                                                        Command="{Binding $parent[Window].((vm:ModDetailViewModel)DataContext).ShowSimilarDetailsCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:ChromeWindow>
