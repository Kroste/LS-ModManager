<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LSModManager.Views"
        xmlns:controls="using:LSModManager.Controls"
        xmlns:loc="using:LSModManager.Localization"
        x:Class="LSModManager.Views.ConfirmDialog"
        Width="460" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" x:Name="TitleBarControl" Title="" />

        <Border DockPanel.Dock="Bottom" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButton" Classes="ghost"
                        Content="{loc:Tr Common_Cancel}" Click="OnCancelClick" />
                <Button x:Name="ConfirmButton" Classes="danger"
                        Content="{loc:Tr Common_Confirm}" Click="OnConfirmClick" />
            </StackPanel>
        </Border>

        <StackPanel Margin="20,20,20,10" Spacing="10">
            <TextBlock x:Name="MessageText" Classes="secondary" TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</views:ChromeWindow>
