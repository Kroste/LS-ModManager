<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LSModManager.Views"
        xmlns:controls="using:LSModManager.Controls"
        xmlns:vm="using:LSModManager.ViewModels"
        xmlns:loc="using:LSModManager.Localization"
        x:Class="LSModManager.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Width="620" Height="440"
        MinWidth="500" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr Window_Settings}"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Window_Settings}" />

        <Border DockPanel.Dock="Top" Padding="20,14,20,10">
            <StackPanel Spacing="2">
                <TextBlock Classes="h1" Text="{loc:Tr Window_Settings}" />
                <TextBlock Classes="secondary"
                           Text="{loc:Tr Settings_Subtitle}" />
            </StackPanel>
        </Border>

        <!-- Buttons unten -->
        <Border DockPanel.Dock="Bottom" Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="ghost" Content="{loc:Tr Common_Cancel}" Click="OnCancelClick" />
                <Button Classes="accent" Content="{loc:Tr Common_Save}" Click="OnSaveClick" />
            </StackPanel>
        </Border>

        <!-- Inhalt -->
        <ScrollViewer Padding="20,4,20,0">
            <StackPanel Spacing="14">

                <!-- Language-Selector oben — der Nutzer soll die App-Sprache
                     als Erstes sehen können, unabhängig davon in welcher
                     Sprache die App gerade ist. -->
                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Tr Settings_Section_UiLanguage}" Classes="section-label" />
                        <ComboBox ItemsSource="{Binding UiCultures}"
                                  SelectedItem="{Binding SelectedUiCulture}"
                                  Width="260" HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayWithFlag}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{loc:Tr Settings_UiLanguage_Hint}"
                                   Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="h2" Text="{loc:Tr Settings_Section_ModFolder}" />
                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                   Text="{loc:Tr Settings_ModFolder_Description}" />

                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Tr Settings_ModFolder_Detected}" Classes="section-label" />
                            <TextBlock Text="{Binding DetectedPath}" Classes="secondary" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Tr Settings_ModFolder_ManualPath}" Classes="section-label" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <TextBox Text="{Binding ModPathOverride}"
                                         PlaceholderText="{loc:Tr Settings_ModFolder_ManualPathPlaceholder}" />
                                <Button Grid.Column="1" Content="{loc:Tr Settings_ModFolder_Browse}" Click="OnBrowseClick" />
                                <Button Grid.Column="2" Content="{loc:Tr Settings_ModFolder_Redetect}"
                                        Command="{Binding DetectCommand}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="h2" Text="{loc:Tr Settings_Section_Catalog}" />
                        <TextBlock Classes="muted" FontSize="12"
                                   Text="{loc:Tr Settings_Catalog_Description}" />

                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Tr Settings_Catalog_Language}" Classes="section-label" />
                            <ComboBox ItemsSource="{Binding SupportedLanguages}"
                                      SelectedItem="{Binding CatalogLanguage}"
                                      Width="200" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Tr Settings_Catalog_AutoRefresh}" Classes="section-label" />
                            <ComboBox ItemsSource="{Binding RefreshOptions}"
                                      SelectedItem="{Binding SelectedRefreshOption}"
                                      Width="360" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                       Text="{loc:Tr Settings_Catalog_AutoRefreshHint}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:ChromeWindow>
