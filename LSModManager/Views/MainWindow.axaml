<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:LSModManager.Views"
        xmlns:controls="using:LSModManager.Controls"
        xmlns:vm="using:LSModManager.ViewModels"
        xmlns:loc="using:LSModManager.Localization"
        mc:Ignorable="d"
        d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="LSModManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1180" Height="760"
        MinWidth="880" MinHeight="560"
        Title="{loc:Tr Window_Main}"
        Background="{DynamicResource KrosteBackgroundBrush}"
        DragDrop.AllowDrop="True">

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Window_Main}" />

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="18,14,18,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="h1" Text="LS-ModManager" />
                        <TextBlock Classes="muted" VerticalAlignment="Bottom"
                                   Text="{Binding CurrentVersionText}" Margin="0,0,0,4" />
                    </StackPanel>
                    <TextBlock Classes="secondary"
                               Text="{loc:Tr Main_Subtitle}" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           Classes="secondary" FontSize="12"
                           ToolTip.Tip="{Binding ModPath}"
                           Text="{Binding ModPathStatusText}" />
            </Grid>
        </Border>

        <!-- Toolbar-Sektionen -->
        <Border DockPanel.Dock="Top" Padding="18,4,18,10">
            <StackPanel Orientation="Horizontal" Spacing="14">

                <StackPanel>
                    <TextBlock Classes="section-label" Text="{loc:Tr Main_Section_Game}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="accent" Content="{loc:Tr Main_LaunchGame}"
                                Command="{Binding LaunchGameCommand}" />
                        <Button Content="{loc:Tr Main_CheckUpdates}"
                                Command="{Binding CheckModUpdatesCommand}" />
                    </StackPanel>
                </StackPanel>

                <Rectangle Classes="divider-v" />

                <StackPanel>
                    <TextBlock Classes="section-label" Text="{loc:Tr Main_Section_Installation}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="{loc:Tr Main_InstallZip}"
                                Click="OnInstallZipClick" />
                        <Button Content="{loc:Tr Main_Refresh}"
                                Command="{Binding RefreshInstalledCommand}" />
                    </StackPanel>
                </StackPanel>

                <Rectangle Classes="divider-v" />

                <StackPanel>
                    <TextBlock Classes="section-label" Text="{loc:Tr Main_Section_System}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="{loc:Tr Main_OpenModFolder}"
                                Command="{Binding OpenModFolderCommand}" />
                        <Button Content="{loc:Tr Main_OpenDownloadsFolder}"
                                Command="{Binding OpenDownloadsFolderCommand}" />
                        <Button Content="{loc:Tr Main_Backup}" Click="OnBackupClick" />
                        <Button Content="{loc:Tr Main_Restore}" Click="OnRestoreClick" />
                        <Button Content="{loc:Tr Main_Settings}" Click="OnSettingsClick" />
                        <Button Classes="ghost" Content="{loc:Tr Main_About}" Click="OnAboutClick" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Statusbar unten -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource KrosteTitleBarBrush}"
                BorderBrush="{DynamicResource KrosteBorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,6">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" IsIndeterminate="True"
                             Width="120" Margin="12,0"
                             IsVisible="{Binding IsBusy}" />
                <!-- Zähler-Suffix: Zahl aus Binding + statischer Suffix aus {loc:Tr} —
                     so bleibt Live-Sprachwechsel funktional ohne VM-Notify-Handler. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="muted" VerticalAlignment="Center"
                               Text="{Binding InstalledMods.Count}" />
                    <TextBlock Classes="muted" VerticalAlignment="Center"
                               Text="{loc:Tr Statusbar_InstalledCountSuffix}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content-Tabs -->
        <TabControl Padding="14,4,14,10">

            <!-- ==== Installierte Mods ==== -->
            <TabItem Header="{loc:Tr Tab_Installed}">
                <Border Classes="card-flat" Padding="0">
                    <DockPanel>
                        <TextBox DockPanel.Dock="Top" Margin="14,10,14,6"
                                 Text="{Binding InstalledSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{loc:Tr Installed_SearchPlaceholder}" />
                        <!-- Bulk-Toolbar: sichtbar sobald mind. 1 Item markiert ist (Ctrl-Klick / Shift-Klick) -->
                        <Border DockPanel.Dock="Top" Padding="14,4,14,6"
                                Background="{DynamicResource KrosteAccentSoftBrush}"
                                IsVisible="{Binding #InstalledList.SelectedItems.Count}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- Zähler-Prefix: Zahl aus Binding + statischer Suffix aus {loc:Tr} -->
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding #InstalledList.SelectedItems.Count}" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{loc:Tr Installed_BulkSelectedSuffix}" />
                                <Button Content="{loc:Tr Installed_BulkEnable}" Click="OnBulkEnableClick" />
                                <Button Content="{loc:Tr Installed_BulkDisable}" Click="OnBulkDisableClick" />
                                <Button Classes="danger" Content="{loc:Tr Installed_BulkUninstall}"
                                        Click="OnBulkUninstallClick" />
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="InstalledList"
                             ItemsSource="{Binding InstalledMods}"
                             SelectedItem="{Binding SelectedInstalled}"
                             SelectionMode="Multiple"
                             Background="Transparent" BorderThickness="0"
                             Padding="10">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:InstalledModItemViewModel">
                                <Border Classes="card" Margin="0,0,0,8" Padding="12">
                                    <Grid ColumnDefinitions="112,*,Auto">
                                        <Border Width="112" Height="96"
                                                Background="{DynamicResource KrosteSurfaceBrush}"
                                                CornerRadius="6" ClipToBounds="True">
                                            <Panel>
                                                <TextBlock Text="🚜" FontSize="42"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource KrosteMutedTextBrush}" />
                                                <Image Source="{Binding Preview}"
                                                       Stretch="UniformToFill" />
                                            </Panel>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,2,0,2" Spacing="4">
                                            <TextBlock Text="{Binding DisplayTitle}" Classes="h2" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Author}" Classes="muted" />
                                                <TextBlock Text="·" Classes="muted"
                                                           IsVisible="{Binding Version, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Text="{Binding Version}" Classes="muted" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                <TextBlock Text="{Binding SizeText}" Classes="secondary" FontSize="12" />
                                                <!-- Aktiv/Deaktiviert: zwei alternative TextBlocks statt VM-Property,
                                                     damit Live-Sprachwechsel automatisch durchschlägt. -->
                                                <TextBlock Text="{loc:Tr Installed_StatusActive}" Classes="secondary" FontSize="12"
                                                           Foreground="{DynamicResource LsFarmingGreenBrush}"
                                                           IsVisible="{Binding Model.IsEnabled}" />
                                                <TextBlock Text="{loc:Tr Installed_StatusDisabled}" Classes="secondary" FontSize="12"
                                                           Foreground="{DynamicResource LsFarmingGreenBrush}"
                                                           IsVisible="{Binding !Model.IsEnabled}" />
                                                <TextBlock Text="{loc:Tr Installed_Multiplayer}" Classes="secondary" FontSize="12"
                                                           IsVisible="{Binding MultiplayerSupported}" />
                                                <!-- Update-Badge: Prefix aus {loc:Tr} + Version-Zahl aus Binding -->
                                                <StackPanel Orientation="Horizontal" Spacing="0"
                                                            IsVisible="{Binding HasUpdate}">
                                                    <TextBlock Text="{loc:Tr Installed_UpdateAvailablePrefix}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource KrosteGoldBrush}" />
                                                    <TextBlock Text="{Binding UpdateAvailableVersion}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource KrosteGoldBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Model.FileName}"
                                                       Classes="muted" FontSize="10" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding ErrorText}"
                                                       Foreground="{DynamicResource KrosteDangerBrush}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       IsVisible="{Binding HasError}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                            <Button Classes="accent" Content="{loc:Tr Installed_InstallUpdate}"
                                                    IsVisible="{Binding HasUpdate}"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).UpdateModCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{loc:Tr Installed_ToggleEnabled}"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleEnabledCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="danger" Content="{loc:Tr Installed_Uninstall}"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).UninstallCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ==== ModHub-Katalog ==== -->
            <TabItem Header="{loc:Tr Tab_Catalog}">
                <Border Classes="card-flat" Padding="0">
                    <DockPanel>
                        <!-- Katalog-Toolbar: Kategorie + Suche + Refresh -->
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="240,*,Auto" Margin="14,10,14,6"
                              ColumnSpacing="8">
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      PlaceholderText="{loc:Tr Catalog_AllCategories}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Grid.Column="1"
                                     Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{loc:Tr Catalog_SearchPlaceholder}" />
                            <Button Grid.Column="2" Classes="ghost" Content="↺"
                                    ToolTip.Tip="{loc:Tr Catalog_RefreshTooltip}"
                                    Command="{Binding RefreshCatalogCommand}" />
                        </Grid>

                        <ListBox x:Name="CatalogList"
                                 ItemsSource="{Binding CatalogMods}"
                                 SelectedItem="{Binding SelectedCatalog}"
                                 DoubleTapped="OnCatalogDoubleTapped"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="10,0,10,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:ModHubItemViewModel">
                                    <Border Classes="card" Margin="0,0,0,8" Padding="12">
                                        <Grid ColumnDefinitions="140,*,Auto">
                                            <Border Width="140" Height="90"
                                                    Background="{DynamicResource KrosteSurfaceBrush}"
                                                    CornerRadius="6" ClipToBounds="True">
                                                <Panel>
                                                    <TextBlock Text="🌐" FontSize="36"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource KrosteMutedTextBrush}" />
                                                    <Image controls:UrlImageBehavior.Url="{Binding PreviewUrl}"
                                                           Stretch="UniformToFill" />
                                                </Panel>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="14,2,0,2" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Title}" Classes="h2" TextTrimming="CharacterEllipsis" />
                                                    <Border Background="{DynamicResource KrosteAccentSoftBrush}"
                                                            CornerRadius="10" Padding="8,1"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding NeedsBrowser}">
                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="10"
                                                                   Foreground="{DynamicResource KrosteSecondaryTextBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Author}" Classes="muted" />
                                                    <TextBlock Text="·" Classes="muted"
                                                               IsVisible="{Binding Category, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    <TextBlock Text="{Binding Category}" Classes="muted" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                                <!-- GIANTS: In-App-Download -->
                                                <Button Classes="accent" Content="{loc:Tr Catalog_Download}"
                                                        IsVisible="{Binding CanInAppDownload}"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DownloadCommand}"
                                                        CommandParameter="{Binding}" />
                                                <!-- Modhoster: nur Browser (Login-Pflicht, robots.txt sperrt Auto-Download) -->
                                                <Button Classes="accent" Content="{loc:Tr Catalog_OpenInBrowser}"
                                                        IsVisible="{Binding NeedsBrowser}"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInBrowserCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="{loc:Tr Catalog_Details}"
                                                        HorizontalAlignment="Right"
                                                        IsVisible="{Binding IsGiantsSource}"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowDetailsCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ==== Downloads (heruntergeladen, noch nicht installiert) ==== -->
            <TabItem Header="{loc:Tr Tab_Downloads}">
                <Border Classes="card-flat" Padding="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="14,10,14,6">
                            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Text="{loc:Tr Downloads_Info}" />
                            <Button Grid.Column="1" Content="{loc:Tr Downloads_OpenFolder}"
                                    Command="{Binding OpenDownloadsFolderCommand}" Margin="8,0,0,0" />
                            <Button Grid.Column="2" Classes="ghost" Content="↺"
                                    ToolTip.Tip="{loc:Tr Downloads_RefreshTooltip}"
                                    Margin="4,0,0,0"
                                    Command="{Binding RefreshDownloadedCommand}" />
                        </Grid>

                        <ListBox ItemsSource="{Binding DownloadedMods}"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="10">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:InstalledModItemViewModel">
                                    <Border Classes="card" Margin="0,0,0,8" Padding="12">
                                        <Grid ColumnDefinitions="112,*,Auto">
                                            <Border Width="112" Height="96"
                                                    Background="{DynamicResource KrosteSurfaceBrush}"
                                                    CornerRadius="6" ClipToBounds="True">
                                                <Panel>
                                                    <TextBlock Text="⬇" FontSize="42"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource KrosteMutedTextBrush}" />
                                                    <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                                </Panel>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="14,2,0,2" Spacing="4">
                                                <TextBlock Text="{Binding DisplayTitle}" Classes="h2" />
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Author}" Classes="muted" />
                                                    <TextBlock Text="{Binding Version}" Classes="muted"
                                                               IsVisible="{Binding Version, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="14">
                                                    <TextBlock Text="{Binding SizeText}" Classes="secondary" FontSize="12" />
                                                    <TextBlock Text="{Binding Model.FileName}" Classes="secondary" FontSize="11" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding ErrorText}"
                                                           Foreground="{DynamicResource KrosteDangerBrush}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           IsVisible="{Binding HasError}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                                <Button Classes="accent" Content="{loc:Tr Downloads_Install}"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InstallDownloadCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Classes="danger" Content="{loc:Tr Downloads_Delete}"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteDownloadCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</views:ChromeWindow>
